# Скопируйте в `.env.local` и поправьте под себя. Значения ниже совпадают
# с дефолтами из `src/services/http.ts`, так что без файла проект тоже
# поднимется — при условии, что API запущен на localhost:4000.

# Адрес API для запросов из браузера. `NEXT_PUBLIC_*` подставляется на этапе
# сборки, то есть попадает в клиентский бандл — секретов здесь быть не должно.
NEXT_PUBLIC_API_URL=http://localhost:4000

# Адрес API для запросов из серверного рантайма Next. Отличается от публичного
# только в docker: изнутри сети контейнер API виден по имени сервиса, а не по
# проброшенному на хост порту. Задействуется в фазе 2.1 вместе с SSR.
# API_URL_INTERNAL=http://api:4000
